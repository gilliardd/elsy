{
  "name": "elsy",
  "version": "1.0.0",
  "description": "Elsy — assistente financeira no WhatsApp (SaaS multi-tenant com Asaas)",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:bootstrap-admin": "ts-node scripts/clone_categories_to_admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "frontend:install": "cd frontend && npm install",
    "frontend:build": "cd frontend && npm run build",
    "setup": "npm install && npm run frontend:install && npm run frontend:build && npm run db:migrate",
    "all": "npm run frontend:build && npm run dev"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "finance",
    "saas",
    "openai",
    "asaas"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.6.5",
    "nodemailer": "^8.0.7",
    "openai": "^4.24.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  }
}
